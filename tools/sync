#!/usr/bin/env bash
# Copies the library into an addon repository, as it ships there:
#   tools/sync ~/Dokumente/ForeverGroupFinder [...]
# -> <repo>/Libs/LibForeverThemes/{LibForeverThemes.lua,Media/}
# The copy is committed in the addon repo; its tests compare it with this
# repo when it sits next to it.
set -eu
HERE="$(cd "$(dirname "$0")/.." && pwd)"
[ $# -ge 1 ] || { echo "usage: tools/sync <addon repo> [...]" >&2; exit 2; }
# Only a committed library goes out: its tests check that MINOR was raised
# against the commits, and an addon's copy must equal a commit here.
if [ -n "$(git -C "$HERE" status --porcelain -- LibForeverThemes.lua Media)" ]; then
    echo "LibForeverThemes has uncommitted changes; commit them (with MINOR raised) first" >&2
    exit 1
fi
for repo in "$@"; do
    ls "$repo"/*.toc >/dev/null 2>&1 || { echo "no addon (TOC) in $repo" >&2; exit 1; }
    dest="$repo/Libs/LibForeverThemes"
    mkdir -p "$dest"
    cp "$HERE/LibForeverThemes.lua" "$dest/"
    rsync -a --delete "$HERE/Media/" "$dest/Media/"
    echo "synced $dest"
done
